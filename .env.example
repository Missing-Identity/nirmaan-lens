# Copy this file to .env.local. Never commit the real key.
OPENAI_API_KEY=

# Current balanced default; override without changing code.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Set to 1 for the deterministic, zero-cost local embedding used in tests.
NIRMAAN_OFFLINE=0

